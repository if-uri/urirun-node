# Example environment for urirun-node. Copy to .env and adjust for your node.
URIRUN_NODE_ENV=development
URIRUN_NODE_LOG_LEVEL=INFO
URIRUN_NODE_DATA_DIR=.urirun/node
URIRUN_NODE_MESH_ENABLED=true
URIRUN_NODE_ROUTING_TABLE_PATH=.urirun/node/routes.json
URIRUN_NODE_TRANSPORT_BIND=127.0.0.1:0
URIRUN_NODE_FLOW_MAX_INFLIGHT=128
URIRUN_NODE_EPISODE_RECORD=false
URIRUN_NODE_TWIN_STORE_PATH=.urirun/node/twin_store
URIRUN_NODE_CONFIG_PATH=.urirun/node/config.json
URIRUN_NODE_HEALTH_TIMEOUT_SECONDS=5
